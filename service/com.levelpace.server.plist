<?xml version="1.0" encoding="UTF-8"?>
<!--
    Runs the whole LevelPace service -- server, public tunnel, and board
    publishing -- as a background job that survives closing the terminal,
    logging out, and rebooting.

    Install:
      cp service/com.levelpace.server.plist ~/Library/LaunchAgents/
      launchctl load -w ~/Library/LaunchAgents/com.levelpace.server.plist

    Stop / uninstall:
      launchctl unload -w ~/Library/LaunchAgents/com.levelpace.server.plist

    Check it:
      launchctl list | grep levelpace
      tail -f /tmp/levelpace-service.log

    This runs run-everything.command rather than the server alone. Running only
    the server would leave the public address unowned: quick tunnels change on
    every restart, and the address has to be re-published to Pages when it does.
    The script handles that, and exits when its tunnel dies so that KeepAlive
    brings the whole set back up together with a fresh, published address.

    The token is read from the .token file rather than written here, so this
    file carries no secret and is safe to commit.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.levelpace.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-lc</string>
        <string>cd "$HOME/DAN WOW ADDON" &amp;&amp; exec ./run-everything.command</string>
    </array>

    <!-- Start at login, and restart whenever it exits -- including the
         deliberate exit it performs when its tunnel drops. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Do not hammer a crash loop: cloudflared missing, no .token, no network. -->
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>/tmp/levelpace-service.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/levelpace-service.log</string>
</dict>
</plist>
