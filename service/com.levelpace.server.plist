<?xml version="1.0" encoding="UTF-8"?>
<!--
    Runs the LevelPace server as a background service so it survives closing
    the terminal, logging out, and rebooting.

    Install:
      cp service/com.levelpace.server.plist ~/Library/LaunchAgents/
      launchctl load -w ~/Library/LaunchAgents/com.levelpace.server.plist

    Stop / uninstall:
      launchctl unload -w ~/Library/LaunchAgents/com.levelpace.server.plist

    Check it:
      launchctl list | grep levelpace
      tail -f /tmp/levelpace-server.log

    The token is read from the .token file rather than written here, so this
    file carries no secret and could be committed without care. It is wired
    through a tiny shell wrapper because launchd does not expand $(...) in
    ProgramArguments.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.levelpace.server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>cd "$HOME/DAN WOW ADDON" &amp;&amp; LEVELPACE_TOKEN="$(cat .token 2>/dev/null)" exec /usr/bin/python3 server/levelpace_server.py --port 8080 --db server/levelpace.db</string>
    </array>

    <!-- Start at login and restart if it ever exits. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Do not hammer the CPU if it is crash-looping on a bad config. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/tmp/levelpace-server.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/levelpace-server.log</string>
</dict>
</plist>
