.DS_Store

# Build output
dist/

# Server runtime state -- never commit a database of other people's data
*.db
*.db-wal
*.db-shm
server/levelpace.db*
inbox/*
!inbox/PUT-FILES-HERE.txt

# Generated by the uploader, per-install
LevelPace/Baseline.lua.tmp
LevelPace/Board.lua.tmp

# Real tunnel config: contains your tunnel UUID and credentials path. The
# committed file is config.example.yml.
cloudflare/config.yml

# The distributed server.txt carries the submission token. Keep the template
# (address only, no secret), never a filled-in one.
server.txt
!packaging/server.txt

# The submission token itself. build.sh injects it into the distributed
# server.txt; git must never see it.
.token

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editors
.vscode/
.idea/
*.swp
